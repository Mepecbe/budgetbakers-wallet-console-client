{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"experimentalDecorators": true,
		"emitDecoratorMetadata": true,
		"sourceMap": true,
		"strict": true,
		"declaration": true,
		"declarationMap": true,
		"strictNullChecks": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"strictBindCallApply": true,
		"strictFunctionTypes": true,
		"strictPropertyInitialization": true,
		"lib": [
			"ES2020"
		],
		"types": ["node"],
		"module": "commonjs",
		"target": "ES2020",
		"outDir": "dist",
		"rootDir": "src",
		"allowJs": false,
		"alwaysStrict": true
	},
	"include": [
		"./src"
	],
	"exclude": [
		"node_modules"
	],
	"assets": [
		"**/*.sql"
	]
}